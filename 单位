    <script>
        // 导航栏滚动效果
        const navbar = document.getElementById('navbar');
        const navLogo = document.getElementById('nav-logo');
        const navLinks = document.querySelectorAll('.nav-link');

        window.addEventListener('scroll', function() {
            if (window.scrollY > 50) {
                navbar.classList.add('bg-white', 'shadow-md', 'py-2');
                navbar.classList.remove('py-4');
                navLogo.classList.remove('text-white', 'text-shadow');
                navLogo.classList.add('text-primary');
                navLinks.forEach(link => {
                    link.classList.remove('text-white');
                    link.classList.add('text-gray-800');
                });
            } else {
                navbar.classList.remove('bg-white', 'shadow-md', 'py-2');
                navbar.classList.add('py-4');
                navLogo.classList.add('text-white', 'text-shadow');
                navLogo.classList.remove('text-primary');
                navLinks.forEach(link => {
                    link.classList.add('text-white');
                    link.classList.remove('text-gray-800');
                });
            }
        });

        // 移动端菜单
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', function() {
            mobileMenu.classList.toggle('hidden');
        });

        // 平滑滚动
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    window.scrollTo({
                        top: target.offsetTop - 80,
                        behavior: 'smooth'
                    });
                    // 关闭移动端菜单
                    mobileMenu.classList.add('hidden');
                }
            });
        });
    </script>
